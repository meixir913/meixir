# Your Anthropic API key (https://console.anthropic.com). Without it the app runs in demo mode
# with sample cover letters and a scripted interviewer.
ANTHROPIC_API_KEY=

# ---- ECE Job Feed (all optional; see README → Job feed)
# Official job-board APIs
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
# Secret for the inbound email webhook that receives SEEK / Indeed alert emails
INBOUND_EMAIL_TOKEN=
# Protects the daily collection endpoint (Vercel Cron sends it automatically)
CRON_SECRET=
# If set, only people with this key can add pasted Facebook posts to the feed
FEED_ADMIN_KEY=
# Storage on serverless hosts (Vercel). Otherwise the feed is saved to data/job-feed.json
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
