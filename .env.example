# Your Anthropic API key (https://console.anthropic.com). Without it the app runs in demo mode
# with sample cover letters and a scripted interviewer.
ANTHROPIC_API_KEY=

# ---- ECE Job Feed (all optional; see README → Job feed)
# Official job-board APIs
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
# Secret for the inbound email webhook that receives SEEK / Indeed alert emails
INBOUND_EMAIL_TOKEN=
# Protects the scheduled endpoints (Vercel Cron sends it automatically)
CRON_SECRET=
# If set, only people with this key can add pasted Facebook posts to the feed
FEED_ADMIN_KEY=
# ---- Centre scanner (ACECQA register → centre websites → careers pages)
# One of these finds each centre's website. Google Places is used if both are set.
BRAVE_SEARCH_API_KEY=
GOOGLE_PLACES_API_KEY=
# Work per run (optional)
CENTRE_LOOKUPS_PER_RUN=200
CENTRE_SCANS_PER_RUN=150

# ---- Job alerts
# Public address of the site, used in email links (e.g. https://app.hiremeece.au)
APP_URL=
# Daily email digest via Resend (https://resend.com)
RESEND_API_KEY=
ALERTS_FROM_EMAIL="Hire Me ECE <alerts@hiremeece.au>"
# Instant notifications. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@hiremeece.au

# ---- Storage
# Required on Vercel (read-only filesystem). Vercel's Upstash integration sets KV_REST_API_URL and
# KV_REST_API_TOKEN automatically, which also work. Without these, data is saved under ./data
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
